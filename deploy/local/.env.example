# Local development overrides for the Easy Maid docker compose stack.
# Copy to `.env` and adjust. These are LOCAL-ONLY throwaway values — never reuse
# production secrets here. The compose file has sane defaults, so `.env` is optional.

# Frappe site created on first `docker compose up`.
SITE_NAME=easymaid.localhost

# MariaDB root password (used to create the site DB).
DB_ROOT_PASSWORD=frappe_root

# Frappe "Administrator" login password.
ADMIN_PASSWORD=admin
